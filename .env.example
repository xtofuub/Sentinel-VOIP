# Optional live backend config. Dev mode works without this via local mock API.
# Use a lawful backend you control. Copy to .env.local only when needed.

# Vite dev proxy target for /api/*
VITE_API_PROXY_TARGET=https://your-backend.example/path

# Or call an API base directly from the browser.
# VITE_API_BASE=https://your-backend.example/path

VITE_API_TIMEOUT_MS=15000
